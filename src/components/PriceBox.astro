---
/**
 * "Voir le prix" call to action in the perfume hero. The best offer (cheapest per ml) is a card with the bottle,
 * the price in green and a "view deal" arrow that says it opens the shop; the other shops follow as compact lines. Promos show between their dates.
 *
 * Bots: affiliate links carry no href in the HTML. The link is in data-go and the global script in
 * Layout.astro (data-go handler) turns it into a real href on the first pointer, touch, focus or key event,
 * so crawlers that read or prefetch the page find nothing to follow, while people click as usual.
 * Clicks are sent to Plausible as "Affiliate click" with the shop, the perfume and the page type.
 */
import type { Locale } from '../i18n';
import { shopsForPerfume, shopLink, goLink, formatPrice, offersDate, bottleMl } from '../lib/affiliates';
import { promosFor } from '../lib/promos';
import { EXT_ICON as EXT } from '../lib/icons';

interface Props { locale: Locale; name: string; brand: string; slug: string; from: string; image?: string | null }
const { locale: l, name, brand, slug, from, image } = Astro.props;
const fr = l === 'fr';
const shops = shopsForPerfume(l, slug);
const [first, ...others] = shops;
const promos = promosFor(l, shops.map((x) => x.shop.id));
const seen = offersDate ? new Date(`${offersDate}T12:00:00Z`).toLocaleDateString(fr ? 'fr-FR' : 'en-US', { day: 'numeric', month: 'long', timeZone: 'UTC' }) : '';
const link = (x: (typeof shops)[number]) => (x.offer ? goLink(x.shop, slug) : shopLink(x.shop, `${brand} ${name}`));
const size = (x: (typeof shops)[number]) => (bottleMl(x.offer?.ml) ? ` · ${bottleMl(x.offer?.ml)} ml` : '');
---

{first && (
  <div class="buy">
    <a class="buy__card" data-go={link(first)} role="link" tabindex="0" rel="sponsored nofollow noopener" target="_blank" data-aff={first.shop.id} data-aff-perfume={slug} data-aff-from={from}>
      {image && <img class="buy__img" src={image} alt="" width="64" height="64" loading="lazy" />}
      <span class="buy__info">
        <span class="buy__name">{name}</span>
        <span class="buy__meta">{fr ? `chez ${first.shop.name}` : `at ${first.shop.name}`}{size(first)}</span>
      </span>
      <span class="buy__cta">
        {first.offer && <span class="buy__price"><small>{fr ? 'dès' : 'from'}</small>{formatPrice(first.offer, l)}</span>}
        <span class="buy__go">{first.offer ? (fr ? "Voir l'offre" : 'View deal') : (fr ? 'Voir le prix' : 'Check price')}<Fragment set:html={EXT} /></span>
      </span>
    </a>
    {others.length > 0 && (
      <ul class="buy__more" aria-label={fr ? 'Autres boutiques' : 'Other shops'}>
        {others.map((x) => (
          <li>
            <a data-go={link(x)} role="link" tabindex="0" rel="sponsored nofollow noopener" target="_blank" data-aff={x.shop.id} data-aff-perfume={slug} data-aff-from={from}>
              <span>{x.shop.name}<span class="buy__more-size">{size(x)}</span></span>
              <span class="buy__more-price">{x.offer ? formatPrice(x.offer, l) : (fr ? 'voir le prix' : 'see price')}<Fragment set:html={EXT} /></span>
            </a>
          </li>
        ))}
      </ul>
    )}
    {promos.map(({ promo: p, shop: s }) => (
      <p class="buy__promo" data-promo-start={p.start} data-promo-end={p.end} hidden>
        <strong>{p.label} at {s.name}</strong>: {p.text}{p.code && <> <b class="buy__code">{p.code}</b></>} ({p.dates}, online only).{' '}
        <a data-go={goLink(s)} role="link" tabindex="0" rel="sponsored nofollow noopener" target="_blank" data-aff={s.id} data-aff-perfume="promo" data-aff-from={`${from}:promo`}>Shop the sale <span aria-hidden="true">→</span></a>
      </p>
    ))}
    <p class="buy__note">{fr
      ? `Lien affilié : Perfumdle peut toucher une commission, sans surcoût pour vous.${shops.some((x) => x.offer) ? ` Prix relevé le ${seen}, il peut avoir changé.` : ' Prix et stock fixés par la boutique.'}`
      : `Affiliate link: Perfumdle may earn a commission at no extra cost to you.${shops.some((x) => x.offer) ? ` Price checked ${seen}, it may have changed.` : ' Price and stock are set by the shop.'}`}</p>
  </div>
)}

<script>
  // Promos: shown only between their start and end (the HTML is rebuilt daily, the clock decides in between)
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('[data-promo-start]').forEach((el) => {
    el.hidden = !(now >= Date.parse(el.dataset.promoStart ?? '') && now < Date.parse(el.dataset.promoEnd ?? ''));
  });
</script>
