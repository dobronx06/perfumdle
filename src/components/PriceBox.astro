---
/**
 * "Voir le prix" call to action in the perfume hero: one button per affiliate shop serving this locale,
 * each opening the shop's search for the perfume. Renders nothing when no shop serves the locale yet. Clicks are sent to Plausible as
 * "Affiliate click" with the shop, the perfume and the page type.
 */
import type { Locale } from '../i18n';
import { shopsFor, shopLink } from '../lib/affiliates';

interface Props { locale: Locale; name: string; brand: string; slug: string; from: string }
const { locale: l, name, brand, slug, from } = Astro.props;
const fr = l === 'fr';
const shops = shopsFor(l);
---

{shops.length > 0 && (
  <div class="buy">
    {shops.map((s) => (
      <a class="buy__btn" href={shopLink(s, `${brand} ${name}`)} rel="sponsored nofollow noopener" target="_blank" data-aff={s.id} data-aff-perfume={slug} data-aff-from={from}>
        <span class="buy__label">{fr ? `Voir le prix de ${name}` : `Check the price of ${name}`}</span>
        <span class="buy__shop">{fr ? `chez ${s.name}` : `at ${s.name}`} <span aria-hidden="true">→</span></span>
      </a>
    ))}
    <p class="buy__note">{fr
      ? 'Lien affilié : Perfumdle peut toucher une commission, sans surcoût pour vous. Prix et stock fixés par la boutique.'
      : 'Affiliate link: Perfumdle may earn a commission at no extra cost to you. Price and stock are set by the shop.'}</p>
  </div>
)}

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-aff]').forEach((a) => a.addEventListener('click', () => {
    try { (window as unknown as { plausible?: (n: string, o: { props: Record<string, string> }) => void }).plausible?.('Affiliate click', { props: { shop: a.dataset.aff ?? '', perfume: a.dataset.affPerfume ?? '', from: a.dataset.affFrom ?? '' } }); } catch { /* analytics never blocks the link */ }
  }));
</script>
