---
import data from '../data/data.json';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header class="site-header">
  <a href={localePath(locale)} class="site-logo">{data.titre}</a>
  <nav>
    <a
      href={localePath(locale, '/liste-150-parfums-perfumdle/')}
      class="header-nav-link"
      title={t(locale, 'nav.all_perfumes')}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
    </a>
    <span
      id="streak-display"
      class="streak-display"
      style="padding: 0.25rem 0.5rem; margin: 0;"
      aria-label={t(locale, 'game.streak_label')}
    >
      <span aria-hidden="true">&#x1F525;</span>
      <span class="streak-count" id="streak-count">0</span>
    </span>
    <LanguageSwitcher locale={locale} />
  </nav>
</header>
