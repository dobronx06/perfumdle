---
import { type Locale } from '../i18n';
import { url, families, notes, brands, familyName, noteName, GUIDES, genders, seasons } from '../lib/catalog';
import { liveOfKind, hubCopy, rankedBase } from '../lib/ranked';

interface Props { locale: Locale }
const { locale } = Astro.props;
const fr = locale === 'fr';
const year = new Date().getFullYear();

const topBrands = [...brands].sort((a, b) => b.perfumes.length - a.perfumes.length).slice(0, 10);
const topNotes = notes.slice(0, 10);
const hubs = (['best', 'nose', 'guide'] as const)
  .filter((k) => liveOfKind(k).length && hubCopy(k))
  .map((k) => ({ href: rankedBase[k](locale), label: { best: fr ? 'Meilleurs parfums' : 'Best perfumes', nose: fr ? 'Parfumeurs' : 'Perfumers', guide: fr ? 'Guides pratiques' : 'Practical guides' }[k] }));
---

<footer class="colophon">
  <div class="colophon__grid">
    <div class="colophon__brand">
      <a href={url.home(locale)} class="wordmark wordmark--lg">Perfumdle</a>
      <p>{fr
        ? "Encyclopédie indépendante des parfums iconiques : notes, maisons, familles olfactives et époques. Et, chaque jour, un parfum mystère à deviner."
        : 'An independent encyclopedia of iconic perfumes: notes, houses, olfactory families and eras. And, every day, a mystery perfume to guess.'}</p>
      <a href={url.game(locale)} class="link-arrow">{fr ? 'Jouer au parfum du jour' : "Play today's perfume"}</a>
    </div>
    <nav aria-label={fr ? 'Maisons' : 'Houses'}>
      <h2>{fr ? 'Maisons' : 'Houses'}</h2>
      {topBrands.map((b) => <a href={url.brand(locale, b.name)}>{b.name}</a>)}
      <a href={url.brands(locale)} class="more">{fr ? 'Toutes les maisons' : 'All houses'}</a>
    </nav>
    <nav aria-label="Notes">
      <h2>Notes</h2>
      {topNotes.map((n) => <a href={url.note(locale, n.key)}>{noteName(n.key, locale)}</a>)}
      <a href={url.notes(locale)} class="more">{fr ? 'Toutes les notes' : 'All notes'}</a>
    </nav>
    <nav aria-label={fr ? 'Familles et sélections' : 'Families & edits'}>
      <h2>{fr ? 'Familles' : 'Families'}</h2>
      {families.slice(0, 8).map((f) => <a href={url.family(locale, f.key)}>{familyName(f.key, locale)}</a>)}
      {genders.map((g) => <a href={url.gender(locale, g.key)}>{fr ? g.name_fr : g.name_en}</a>)}
      {seasons.map((s) => <a href={url.season(locale, s.key)}>{fr ? s.name_fr : s.name_en}</a>)}
    </nav>
    <nav aria-label="Guides">
      <h2>Guides</h2>
      {hubs.map((h) => <a href={h.href}><strong>{h.label}</strong></a>)}
      {GUIDES.map((g) => <a href={`/${locale}/${g.slug}/`}>{fr ? g.fr : g.en}</a>)}
    </nav>
  </div>
  <div class="colophon__legal">
    <p>{fr
      ? 'Perfumdle est un site éditorial indépendant, sans lien avec les maisons citées. Les noms et marques appartiennent à leurs propriétaires respectifs.'
      : 'Perfumdle is an independent editorial site, not affiliated with the houses mentioned. Names and trademarks belong to their respective owners.'}</p>
    <p>&copy; {year} Perfumdle · <a href={fr ? '/en/' : '/fr/'}>{fr ? 'English' : 'Français'}</a></p>
  </div>
</footer>
