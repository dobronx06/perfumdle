---
import '../styles/global.css';
import data from '../data/data.json';
import theme from '../data/theme.json';
import { t, altLocale, localePath, ogLocale, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
}

const { locale, title = data.titre, description = t(locale, 'site.description'), canonical, jsonLd } = Astro.props;
const other = altLocale(locale);

const fontFamilies = [
  `${theme.typo.titre.replace(/ /g, '+')}:wght@400;700`,
  `${theme.typo.corps.replace(/ /g, '+')}:wght@400;500;600;700`,
];
const fontUrl = `https://fonts.googleapis.com/css2?${fontFamilies.map((f) => `family=${f}`).join('&')}&display=swap`;

const pathname = Astro.url.pathname;
const frPath = pathname.replace(`/${locale}/`, '/fr/');
const enPath = pathname.replace(`/${locale}/`, '/en/');

const cssVars = [
  `--font-titre: '${theme.typo.titre}', cursive`,
  `--font-corps: '${theme.typo.corps}', system-ui, sans-serif`,
  `--color-primary: ${theme.couleurs.primary}`,
  `--color-accent: ${theme.couleurs.accent}`,
  `--color-bg: ${theme.couleurs.bg}`,
  `--color-bg-card: ${theme.couleurs.bgCard}`,
  `--color-text: ${theme.couleurs.text}`,
  `--color-text-muted: ${theme.couleurs.textMuted}`,
  `--color-correct: ${theme.couleurs.correct}`,
  `--color-close: ${theme.couleurs.close}`,
  `--color-wrong: ${theme.couleurs.wrong}`,
  `--color-danger: ${theme.couleurs.danger ?? '#ef4444'}`,
  `--radius: ${theme.style.borderRadius}`,
  `--border-color: ${theme.style.borderColor}`,
].join('; ');
---

<!doctype html>
<html lang={locale} style={cssVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={data.titre} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(other)} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="fr" href={`https://perfumdle.com${frPath}`} />
    <link rel="alternate" hreflang="en" href={`https://perfumdle.com${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`https://perfumdle.com${frPath}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontUrl} rel="stylesheet" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <script defer data-domain="perfumdle.com" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
