---
import CollectionView from '../../../views/CollectionView.astro';
import { familyPage } from '../../../lib/pages';
import { families } from '../../../lib/catalog';

export function getStaticPaths() {
  return families.map((f) => ({ params: { slug: f.slug_en }, props: { key: f.key } }));
}
const props = familyPage(Astro.props.key, 'en');
---

<CollectionView {...props} />
