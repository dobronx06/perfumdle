---
import RankedView from '../../../../views/RankedView.astro';
import { liveOfKind, rankedUrl } from '../../../../lib/ranked';

export function getStaticPaths() {
  return liveOfKind('ng').map((d) => {
    const [, , , slug, g] = rankedUrl(d, 'en').split('/');
    return { params: { slug, g }, props: { d } };
  });
}
---

<RankedView d={Astro.props.d} locale="en" />
