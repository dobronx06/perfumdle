---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import pool from '../../data/game-pool.json';
import { perfumes, perfumeBySlug, noteName, familyName, allNotes, type Perfume } from '../../lib/catalog';
import { t, localePath, type Locale } from '../../i18n';
import { guideUrl } from '../../lib/catalog';

/** FR only here; the EN version is rendered by src/pages/en/perfumdle-strategy-guide.astro (English slug). */
export function getStaticPaths() {
  return [{ params: { lang: 'fr' }, props: { locale: 'fr' as Locale } }];
}

const locale = (Astro.props.locale ?? Astro.params.lang) as Locale;
const fr = locale === 'fr';
const canonical = `https://perfumdle.com${guideUrl('guide-strategie-perfumdle', locale)}`;

// The daily draw: the 100 most searched perfumes, in popularity order (same list as the game).
const drawn = (pool as string[]).map((s) => perfumeBySlug.get(s)).filter((p): p is Perfume => !!p);
const drawCount = drawn.length;
const guessable = perfumes.length;

// Main family, same rule as the game (first word of the dataset label).
const FIRST_WORD: Record<string, string> = {
  floral: 'floral', oriental: 'oriental', amber: 'oriental', ambery: 'oriental', woody: 'woody', chypre: 'chypre',
  fougère: 'fougere', fougere: 'fougere', citrus: 'citrus', gourmand: 'gourmand', leather: 'leather', aquatic: 'aquatic',
  marine: 'aquatic', aromatic: 'aromatic', fruity: 'fruity', spicy: 'spicy', musk: 'musky', musky: 'musky',
  green: 'green', powdery: 'powdery', aldehyde: 'powdery',
};
const mainFamily = (p: Perfume) => FIRST_WORD[p.family.split(' ')[0].toLowerCase()] ?? p.families[0] ?? 'floral';

const genderCounts = {
  feminine: drawn.filter((p) => p.gender === 'Feminine').length,
  masculine: drawn.filter((p) => p.gender === 'Masculine').length,
  unisex: drawn.filter((p) => p.gender === 'Unisex').length,
};
const pct = (n: number) => Math.round((n / drawCount) * 100);

const years = drawn.map((p) => p.year).sort((a, b) => a - b);
const medianYear = years[Math.floor(years.length / 2)];
const since2000 = drawn.filter((p) => p.year >= 2000).length;

const houseCounts = drawn.reduce((acc, p) => {
  acc[p.brand] = (acc[p.brand] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const topHouses = Object.entries(houseCounts).sort((a, b) => b[1] - a[1]).slice(0, 3);

// Periods of the draw, with the most searched examples of each.
const periods = [
  { label: fr ? 'Avant 1950' : 'Before 1950', from: 0, to: 1950 },
  { label: fr ? 'De 1950 à 1979' : '1950 to 1979', from: 1950, to: 1980 },
  { label: fr ? 'De 1980 à 1999' : '1980 to 1999', from: 1980, to: 2000 },
  { label: fr ? 'De 2000 à 2009' : '2000 to 2009', from: 2000, to: 2010 },
  { label: fr ? 'Depuis 2010' : '2010 onwards', from: 2010, to: 9999 },
].map((r) => {
  const list = drawn.filter((p) => p.year >= r.from && p.year < r.to);
  return { ...r, count: list.length, examples: list.slice(0, 3).map((p) => p.name).join(', ') };
});

// Most frequent notes of the draw (sharing them tells you little).
const noteFreq = new Map<string, number>();
for (const p of drawn) for (const n of allNotes(p)) noteFreq.set(n, (noteFreq.get(n) || 0) + 1);
const commonNotes = [...noteFreq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5).map(([n]) => (fr ? noteName(n, locale).toLowerCase() : noteName(n, locale)));

// Best first guess per starting family: a gendered perfume of the draw sharing the most notes with its family.
const avgShared = (p: Perfume, list: Perfume[]) => {
  const own = new Set(allNotes(p));
  const others = list.filter((q) => q.slug !== p.slug);
  return others.reduce((sum, q) => sum + allNotes(q).filter((n) => own.has(n)).length, 0) / Math.max(1, others.length);
};
const byFamily = new Map<string, Perfume[]>();
for (const p of drawn) byFamily.set(mainFamily(p), [...(byFamily.get(mainFamily(p)) ?? []), p]);
const genderLabel = (g: Perfume['gender']) => (fr ? { Feminine: 'féminin', Masculine: 'masculin', Unisex: 'mixte' } : { Feminine: 'feminine', Masculine: 'masculine', Unisex: 'unisex' })[g];
const openers = [...byFamily.entries()]
  .filter(([, list]) => list.length >= 3)
  .sort((a, b) => b[1].length - a[1].length)
  .map(([fam, list]) => {
    const gendered = list.filter((p) => p.gender !== 'Unisex');
    const candidates = gendered.length ? gendered : list;
    const best = candidates
      .map((p) => ({ p, score: avgShared(p, list) }))
      .sort((a, b) => b.score - a.score)[0];
    return { family: familyName(fam, locale), count: list.length, p: best.p, score: best.score.toFixed(1).replace('.', fr ? ',' : '.') };
  });

// A note-heavy probe outside the draw.
const probe = perfumeBySlug.get('parfums-de-marly-lippizan');
const probeNotes = probe ? allNotes(probe).length : 0;

const description = fr
  ? "Règles et stratégie de Perfumdle : 6 essais, un indice de plus à chaque erreur, la flèche d'année et les notes en commun pour trouver le parfum du jour."
  : 'Perfumdle rules and strategy: 6 guesses, a new clue after every miss, the year arrow and shared notes. How to find the perfume of the day faster.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: fr ? 'Comment jouer à Perfumdle et trouver le parfum du jour' : 'How to play Perfumdle and find the perfume of the day',
  description,
  step: [
    {
      '@type': 'HowToStep',
      name: fr ? 'Lire les deux indices de départ' : 'Read the two starting clues',
      text: fr
        ? "Avant le premier essai, le jeu donne la famille olfactive du parfum mystère et une de ses notes de fond."
        : 'Before your first guess, the game shows the mystery perfume’s olfactory family and one of its base notes.',
    },
    {
      '@type': 'HowToStep',
      name: fr ? 'Proposer un premier parfum ciblé' : 'Make a targeted first guess',
      text: fr
        ? `Choisissez un parfum de cette famille qui contient cette note, sorti vers ${medianYear}, féminin ou masculin plutôt que mixte.`
        : `Pick a perfume from that family that contains that note, released around ${medianYear}, feminine or masculine rather than unisex.`,
    },
    {
      '@type': 'HowToStep',
      name: fr ? 'Lire les 4 cases' : 'Read the 4 cells',
      text: fr
        ? "Maison, année, genre et famille sont notés ✓ exact, ≈ proche ou ✗ différent. La flèche d'année indique si le mystère est plus récent (↑) ou plus ancien (↓)."
        : 'House, year, gender and family are marked ✓ exact, ≈ close or ✗ different. The year arrow shows whether the mystery is newer (↑) or older (↓).',
    },
    {
      '@type': 'HowToStep',
      name: fr ? 'Suivre les notes en commun' : 'Follow the shared notes',
      text: fr
        ? 'Gardez les notes partagées dans votre essai suivant et changez de registre quand le compteur reste à 0.'
        : 'Keep the shared notes in your next guess. Switch style when the counter stays at 0.',
    },
    {
      '@type': 'HowToStep',
      name: fr ? 'Utiliser les indices débloqués' : 'Use the unlocked clues',
      text: fr
        ? "Chaque erreur révèle un indice : note de cœur, décennie, genre, note de tête, puis initiale de la maison et flacon flouté."
        : 'Each miss reveals a clue: heart note, decade, gender, top note, then the house initial and a blurred bottle.',
    },
  ],
};
---

<Layout
  title={fr ? "Comment jouer à Perfumdle : stratégie et astuces pour gagner" : "How to play Perfumdle: strategy and tips to win"}
  description={description}
  locale={locale}
  canonical={canonical}
  alternates={{ fr: guideUrl('guide-strategie-perfumdle', 'fr'), en: guideUrl('guide-strategie-perfumdle', 'en') }}
  jsonLd={jsonLd}
>
  <div style="display:flex;flex-direction:column;min-height:100dvh;">
    <Header locale={locale} altHref={guideUrl('guide-strategie-perfumdle', fr ? 'en' : 'fr')} />
    <main class="container content-page" style="flex:1;">
      <nav class="content-nav">
        <a href={localePath(locale)}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          {t(locale, 'content.back_home')}
        </a>
      </nav>

      <h1>{fr ? "Comment jouer à Perfumdle : guide stratégie" : "How to play Perfumdle: strategy guide"}</h1>
      <p class="content-subtitle">
        {fr
          ? "Les règles exactes du jeu et notre méthode pour trouver le parfum du jour en 6 essais ou moins"
          : "The exact rules and our method to find the perfume of the day in 6 guesses or fewer"
        }
      </p>

      <h2>{fr ? "Les règles du jeu" : "Game rules"}</h2>
      {fr ? (
        <p>
          Perfumdle est un jeu de devinette quotidien dans l'esprit de Wordle. Chaque jour à minuit, un parfum mystère est tiré parmi les <strong>{drawCount} parfums les plus recherchés en France</strong> : N°5, Sauvage, Baccarat Rouge 540, La Vie est Belle et les autres. Vous avez <strong>6 essais</strong> pour le trouver.
        </p>
      ) : (
        <p>
          Perfumdle is a daily guessing game in the spirit of Wordle. Every day at midnight, a mystery perfume is drawn from the <strong>{drawCount} most searched perfumes in France</strong>: N°5, Sauvage, Baccarat Rouge 540, La Vie est Belle and the rest. You get <strong>6 guesses</strong> to find it.
        </p>
      )}
      <p>
        {fr
          ? `Pour proposer un parfum, tapez son nom ou sa maison. La recherche couvre les ${guessable} parfums de l'encyclopédie. Un parfum hors des ${drawCount} du tirage ne peut pas gagner, mais il compte comme un essai normal et vous renvoie les mêmes informations.`
          : `To guess, type a perfume or house name. Search covers all ${guessable} perfumes in the encyclopedia. A perfume outside the ${drawCount} in the draw can never win, but it still counts as a normal guess and returns the same information.`
        }
      </p>

      <h3>{fr ? "Ce que vous apprenez à chaque essai" : "What each guess tells you"}</h3>
      <ol>
        <li>{fr ? "Votre essai est comparé au parfum mystère sur 4 cases :" : "Your guess is compared with the mystery perfume on 4 cells:"}</li>
        <ul>
          <li><strong>{fr ? "Maison" : "House"}</strong> : {fr ? "✓ si c'est la même maison, ✗ sinon. Pas de case intermédiaire." : "✓ for the same house, ✗ otherwise. There is no in-between."}</li>
          <li><strong>{fr ? "Année" : "Year"}</strong> : {fr ? "✓ pour l'année exacte, ≈ à 5 ans près, ✗ au-delà. La flèche ↑ signale un parfum mystère plus récent, la flèche ↓ un parfum plus ancien." : "✓ for the exact year, ≈ within 5 years, ✗ beyond that. The ↑ arrow means the mystery perfume is newer, ↓ means it is older."}</li>
          <li><strong>{fr ? "Genre" : "Gender"}</strong> : {fr ? "✓ si c'est le même genre, ≈ si l'un des deux parfums est mixte, ✗ pour un féminin face à un masculin." : "✓ for the same gender, ≈ when one of the two is unisex, ✗ for feminine against masculine."}</li>
          <li><strong>{fr ? "Famille" : "Family"}</strong> : {fr ? "✓ pour la même famille principale, ≈ quand les deux parfums ont une famille en commun (un floral oriental face à un oriental boisé par exemple), ✗ sinon." : "✓ for the same main family, ≈ when the two perfumes share a family (say a floral oriental against a woody oriental), ✗ otherwise."}</li>
        </ul>
        <li>{fr ? "Sous les cases, un compteur affiche le nombre de notes en commun avec le parfum mystère. Les notes partagées sont listées à côté." : "Below the cells, a counter shows how many notes your guess shares with the mystery perfume. The shared notes are listed next to it."}</li>
        <li>{fr ? "Chaque erreur débloque un indice de plus sur le parfum mystère." : "Every miss unlocks one more clue about the mystery perfume."}</li>
        <li>{fr ? "La partie s'arrête quand vous trouvez le parfum ou après le sixième essai manqué." : "The game ends when you find the perfume or after your sixth miss."}</li>
      </ol>

      <h3>{fr ? "Quand arrivent les indices" : "When the clues unlock"}</h3>
      <div class="content-table-wrap">
        <table class="content-table">
          <thead>
            <tr>
              <th>{fr ? "Moment" : "When"}</th>
              <th>{fr ? "Indice révélé" : "Clue revealed"}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>{fr ? "Dès le départ" : "From the start"}</td><td>{fr ? "La famille olfactive et une note de fond" : "The olfactory family and one base note"}</td></tr>
            <tr><td>{fr ? "Après 1 erreur" : "After 1 miss"}</td><td>{fr ? "Une note de cœur" : "A heart note"}</td></tr>
            <tr><td>{fr ? "Après 2 erreurs" : "After 2 misses"}</td><td>{fr ? "L'époque (la décennie)" : "The era (decade)"}</td></tr>
            <tr><td>{fr ? "Après 3 erreurs" : "After 3 misses"}</td><td>{fr ? "Le genre" : "The gender"}</td></tr>
            <tr><td>{fr ? "Après 4 erreurs" : "After 4 misses"}</td><td>{fr ? "Une note de tête" : "A top note"}</td></tr>
            <tr><td>{fr ? "Après 5 erreurs" : "After 5 misses"}</td><td>{fr ? "L'initiale de la maison et le flacon flouté" : "The house initial and a blurred bottle"}</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        {fr
          ? "Au sixième essai, vous jouez donc avec la famille, trois notes, la décennie, le genre et l'initiale de la maison. Un essai raté n'est jamais gaspillé : il paie toujours un indice."
          : "By your sixth guess you know the family, three notes, the decade, the gender and the house initial. A miss is never wasted. It always buys you a clue."
        }
      </p>

      <h3>{fr ? "Entraînement, partage et série" : "Practice, sharing and streak"}</h3>
      <p>
        {fr
          ? `Le mode Entraînement tire un nouveau parfum parmi les ${drawCount} à chaque partie, sans limite et jamais celui du jour. Il ne compte pas dans la série. C'est l'endroit idéal pour roder une méthode.`
          : `Practice mode draws a new perfume from the ${drawCount} for every game, with no limit and never today’s answer. It does not count towards your streak. Use it to test a method.`
        }
      </p>
      <p>
        {fr
          ? "En fin de partie, le bouton de partage génère votre grille en carrés de couleur : vert pour exact, jaune pour proche, blanc pour différent. Chaque ligne indique aussi le nombre de notes en commun. Le nom du parfum n'y figure pas."
          : "When the game ends, the share button builds your grid in colored squares: green for exact, yellow for close, white for different. Each row also shows the number of shared notes. The perfume’s name is never included."
        }
      </p>
      <p>
        {fr
          ? "La série compte vos victoires quotidiennes d'affilée. Une défaite la remet à zéro. Un jour sauté la fait repartir de 1 à la victoire suivante. Partie et série sont enregistrées dans votre navigateur."
          : "Your streak counts daily wins in a row. A loss resets it to zero. Skip a day and it restarts at 1 with your next win. Games and streak are saved in your browser."
        }
      </p>

      <h2>{fr ? "Stratégies gagnantes" : "Winning strategies"}</h2>

      <h3>{fr ? "1. Le premier essai : partir des indices gratuits" : "1. First guess: start from the free clues"}</h3>
      <p>
        {fr
          ? "Vous ne jouez jamais à l'aveugle. La famille olfactive et une note de fond sont affichées avant le premier essai. Le bon réflexe : proposer un parfum de cette famille qui contient cette note. La case Famille passe au vert et le compteur démarre au moins à 1."
          : "You never start blind. The olfactory family and a base note are on screen before your first guess. The right move is to pick a perfume from that family that contains that note. The Family cell turns green and the counter starts at 1 or more."
        }
      </p>
      <p>
        {fr
          ? `Visez ensuite une année proche de ${medianYear}. C'est l'année médiane du tirage : environ la moitié des ${drawCount} parfums est sortie avant, l'autre après. ${since2000} d'entre eux datent de 2000 ou plus tard, donc un classique de 1925 en ouverture apprend très peu.`
          : `Then aim for a year close to ${medianYear}. It is the median year of the draw: about half of the ${drawCount} perfumes came out before it, half after. ${since2000} of them date from 2000 or later, so opening with a 1925 classic teaches you very little.`
        }
      </p>
      <p>
        {fr
          ? "Côté genre, évitez le mixte au premier essai. Face à un mystère féminin ou masculin, un mixte donne ≈ sans dire lequel. Un féminin ou un masculin tranche dans tous les cas : ✓, ≈ (mystère mixte) ou ✗ (genre opposé)."
          : "For gender, avoid a unisex opener. Against a feminine or masculine mystery, a unisex guess returns ≈ without telling you which. A feminine or masculine guess always settles it: ✓, ≈ (unisex mystery) or ✗ (the other one)."
        }
      </p>
      <p>
        {fr
          ? `La maison n'a pas de case « proche ». ${topHouses[0][0]} (${topHouses[0][1]} parfums du tirage), ${topHouses[1][0]} (${topHouses[1][1]}) et ${topHouses[2][0]} (${topHouses[2][1]}) sont les paris les plus rentables quand vous hésitez entre deux candidats.`
          : `House has no "close" state. ${topHouses[0][0]} (${topHouses[0][1]} perfumes in the draw), ${topHouses[1][0]} (${topHouses[1][1]}) and ${topHouses[2][0]} (${topHouses[2][1]}) are the best bets when two candidates look equal.`
        }
      </p>
      <p>
        <strong>{fr ? "Nos premiers essais selon la famille de départ :" : "Our opening guesses by starting family:"}</strong>
      </p>
      <div class="content-table-wrap">
        <table class="content-table">
          <thead>
            <tr>
              <th>{fr ? "Famille donnée" : "Starting family"}</th>
              <th>{fr ? "Premier essai" : "First guess"}</th>
              <th>{fr ? "Notes en commun (moyenne)" : "Shared notes (average)"}</th>
            </tr>
          </thead>
          <tbody>
            {openers.map((o) => (
              <tr>
                <td>{o.family} ({o.count})</td>
                <td><strong>{o.p.name}</strong> ({o.p.brand}, {o.p.year}, {genderLabel(o.p.gender)})</td>
                <td>{o.score}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        {fr
          ? "La moyenne est calculée sur les parfums du tirage de la même famille principale. Ces essais font partie du tirage : ils peuvent gagner du premier coup. Si la note de fond donnée n'y figure pas, prenez un voisin qui la contient."
          : "The average is computed against the perfumes of the draw with the same main family. These openers are in the draw themselves, so they can win on the first try. If the given base note is missing from them, pick a neighbor that has it."
        }
      </p>

      <h3>{fr ? "2. Exploiter les notes en commun" : "2. Work the shared notes"}</h3>
      <p>
        {fr
          ? "C'est l'indice le plus riche du jeu. La liste vous dit quelles notes de votre essai se retrouvent dans le mystère. Gardez-les dans l'essai suivant et cherchez un parfum qui en ajoute d'autres."
          : "This is the richest clue in the game. The list tells you which notes of your guess are in the mystery. Keep them in your next guess and look for a perfume that adds more."
        }
      </p>
      <p>
        {fr
          ? "À 0 note en commun, changez franchement de registre : d'un floral poudré vers un boisé ambré, d'un agrume vers une vanille. À 4 notes ou plus, vous êtes dans le bon voisinage. Restez dans la même famille et la même époque."
          : "At 0 shared notes, change style completely: from a powdery floral to an amber woody, from citrus to vanilla. At 4 notes or more, you are in the right neighborhood. Stay in the same family and era."
        }
      </p>
      <p>
        {fr
          ? `Toutes les notes ne se valent pas. Les plus fréquentes du tirage sont ${commonNotes.join(', ')}. Les partager apprend peu. Une note rare en commun (oud, iris, praline) resserre bien davantage la liste.`
          : `Not all notes are equal. The most frequent ones in the draw are ${commonNotes.join(', ')}. Sharing them tells you little. A rare shared note (oud, iris, praline) narrows the list far more.`
        }
      </p>
      {probe && (
        <p>
          {fr
            ? `Un parfum hors tirage peut servir de sonde. ${probe.name} de ${probe.brand} aligne ${probeNotes} notes : il ne peut pas gagner, mais il en teste beaucoup d'un coup. À réserver au deuxième ou troisième essai, quand le compteur reste bas.`
            : `A perfume outside the draw can work as a probe. ${probe.name} by ${probe.brand} lists ${probeNotes} notes. It cannot win, but it tests a lot of them at once. Keep it for your second or third guess, when the counter stays low.`
          }
        </p>
      )}

      <h3>{fr ? "3. Se servir de la flèche d'année" : "3. Use the year arrow"}</h3>
      <p>
        {fr
          ? "La flèche ↑ veut dire que le mystère est plus récent que votre essai, la flèche ↓ qu'il est plus ancien. Avec ≈, l'écart est de 5 ans au plus et la fenêtre tombe à 11 années possibles."
          : "The ↑ arrow means the mystery is newer than your guess, ↓ means it is older. With ≈ the gap is 5 years at most, which leaves 11 possible years."
        }
      </p>
      <p>
        {fr
          ? "Combinez les flèches. Un ↑ sur un parfum de 2005 puis un ↓ sur un parfum de 2019 enferment le mystère entre 2006 et 2018. Dès la deuxième erreur, la décennie s'affiche en indice et resserre encore l'intervalle."
          : "Combine the arrows. A ↑ on a 2005 perfume then a ↓ on a 2019 one lock the mystery between 2006 and 2018. From your second miss, the decade shows up as a clue and tightens the range further."
        }
      </p>
      <p>
        <strong>{fr ? `Répartition des ${drawCount} parfums du tirage par période :` : `The ${drawCount} perfumes of the draw by period:`}</strong>
      </p>
      <div class="content-table-wrap">
        <table class="content-table">
          <thead>
            <tr>
              <th>{fr ? "Période" : "Period"}</th>
              <th>{fr ? "Nombre de parfums" : "Number of perfumes"}</th>
              <th>{fr ? "Les plus recherchés" : "Most searched"}</th>
            </tr>
          </thead>
          <tbody>
            {periods.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td>{r.count}</td>
                <td>{r.examples}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3>{fr ? "4. Lire les ≈ du genre et de la famille" : "4. Read the ≈ on gender and family"}</h3>
      <p>
        {fr
          ? "Un ≈ sur le genre signale qu'un des deux parfums est mixte. Si vous avez proposé un féminin, le mystère est donc mixte. Si vous avez proposé un mixte, il est féminin ou masculin."
          : "A ≈ on gender means one of the two perfumes is unisex. If you guessed a feminine, the mystery is unisex. If you guessed a unisex, the mystery is feminine or masculine."
        }
      </p>
      <p>
        {fr
          ? "Un ≈ sur la famille veut dire que les deux parfums partagent une famille sans avoir la même famille principale. Comme la famille principale est donnée dès le départ, visez-la directement. Ce ≈ ne sert que si vous testez volontairement une autre famille pour ses notes."
          : "A ≈ on family means the two perfumes share a family but not the same main one. Since the main family is given from the start, aim for it directly. This ≈ only matters when you pick another family on purpose to test its notes."
        }
      </p>

      <h2>{fr ? "Astuces avancées" : "Advanced tips"}</h2>

      <h3>{fr ? "Procéder par élimination" : "Use the process of elimination"}</h3>
      <p>
        {fr
          ? "Après 3 essais, faites le point sur ce que vous savez :"
          : "After 3 guesses, take stock of what you know:"
        }
      </p>
      <ul>
        <li>{fr ? "Les maisons écartées par un ✗" : "Houses ruled out by a ✗"}</li>
        <li>{fr ? "La fourchette d'années entre vos flèches ↑ et ↓" : "The year range between your ↑ and ↓ arrows"}</li>
        <li>{fr ? "Le genre, affiché au plus tard après la troisième erreur" : "The gender, shown after your third miss at the latest"}</li>
        <li>{fr ? "Les notes confirmées. Une note de votre essai absente de la liste n'est pas dans le mystère (la liste affiche 5 notes au plus)." : "The confirmed notes. A note of your guess missing from the list is not in the mystery (the list shows 5 notes at most)."}</li>
      </ul>

      <h3>{fr ? `Connaître les ${drawCount} parfums du tirage` : `Know the ${drawCount} perfumes in the draw`}</h3>
      <p>
        {fr
          ? `Le mystère sort toujours du même vivier. Sur un cycle de ${drawCount} jours, chaque parfum ne sort qu'une fois. Les grands noms reviennent donc forcément :`
          : `The mystery always comes from the same pool. Over a ${drawCount}-day cycle, each perfume comes up only once. The big names are bound to show up:`
        }
      </p>
      <ul>
        {periods.filter((r) => r.count > 0).map((r) => (
          <li><strong>{r.label}</strong> : {r.examples}</li>
        ))}
      </ul>

      <h3>{fr ? "Répartir vos 6 essais" : "Plan your 6 guesses"}</h3>
      <ul>
        <li>{fr ? `Essai 1 : famille et note de fond de départ, année vers ${medianYear}, genre tranché.` : `Guess 1: starting family and base note, a year near ${medianYear}, a clear gender.`}</li>
        <li>{fr ? "Essais 2 et 3 : gardez les notes partagées, suivez la flèche, changez de maison après un ✗." : "Guesses 2 and 3: keep the shared notes, follow the arrow, switch house after a ✗."}</li>
        <li>{fr ? "Essais 4 et 5 : la décennie et le genre sont connus, une note de tête arrive. Visez un parfum précis." : "Guesses 4 and 5: decade and gender are known and a top note arrives. Go for one specific perfume."}</li>
        <li>{fr ? "Essai 6 : l'initiale de la maison et le flacon flouté. Passez en revue les maisons qui commencent par cette lettre." : "Guess 6: the house initial and a blurred bottle. Run through the houses starting with that letter."}</li>
      </ul>

      <h2>{fr ? "Le tirage en chiffres" : "The draw in numbers"}</h2>
      <div class="content-table-wrap">
        <table class="content-table">
          <thead>
            <tr>
              <th>{fr ? "Catégorie" : "Category"}</th>
              <th>{fr ? "Nombre" : "Count"}</th>
              <th>{fr ? "Pourcentage" : "Percentage"}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>{fr ? "Parfums du tirage" : "Perfumes in the draw"}</strong></td>
              <td>{drawCount}</td>
              <td>100%</td>
            </tr>
            <tr>
              <td>{fr ? "Féminins" : "Feminine"}</td>
              <td>{genderCounts.feminine}</td>
              <td>{pct(genderCounts.feminine)}%</td>
            </tr>
            <tr>
              <td>{fr ? "Masculins" : "Masculine"}</td>
              <td>{genderCounts.masculine}</td>
              <td>{pct(genderCounts.masculine)}%</td>
            </tr>
            <tr>
              <td>{fr ? "Mixtes" : "Unisex"}</td>
              <td>{genderCounts.unisex}</td>
              <td>{pct(genderCounts.unisex)}%</td>
            </tr>
            <tr>
              <td>{fr ? "Sortis en 2000 ou après" : "Released in 2000 or later"}</td>
              <td>{since2000}</td>
              <td>{pct(since2000)}%</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        {fr
          ? `Vous pouvez proposer n'importe lequel des ${guessable} parfums de l'encyclopédie, mais le mystère sort toujours de ces ${drawCount}.`
          : `You can guess any of the ${guessable} perfumes in the encyclopedia, but the mystery always comes from these ${drawCount}.`
        }
      </p>

      <h2>{fr ? "Pour aller plus loin" : "Learn more"}</h2>
      <div class="content-links">
        <a href={(locale === 'fr' ? '/fr/parfums/' : '/en/perfumes/')} class="content-link-card">
          <div class="content-link-card__title">{fr ? "Tous les parfums" : "All perfumes"}</div>
          <div class="content-link-card__desc">{fr ? "Révisez les notes et les années" : "Brush up on notes and years"}</div>
        </a>
        <a href={guideUrl('guide-familles-olfactives', locale)} class="content-link-card">
          <div class="content-link-card__title">{fr ? "Les familles olfactives" : "Olfactory families"}</div>
          <div class="content-link-card__desc">{fr ? "Comprendre l'indice de départ" : "Make sense of the starting clue"}</div>
        </a>
        <a href={guideUrl('difference-edp-edt-parfum', locale)} class="content-link-card">
          <div class="content-link-card__title">{fr ? "EDP vs EDT vs Parfum" : "EDP vs EDT vs Perfume"}</div>
          <div class="content-link-card__desc">{fr ? "Les concentrations expliquées" : "Concentrations explained"}</div>
        </a>
      </div>

      <div class="content-cta-box">
        <p>{fr ? "Prêt à tester la méthode sur le parfum du jour ?" : "Ready to try the method on today’s perfume?"}</p>
        <a href={localePath(locale)} class="btn-play">{t(locale, 'content.play_cta')}</a>
      </div>
    </main>
    <Footer locale={locale} />
  </div>
</Layout>
