---
import PerfumeView from '../../../views/PerfumeView.astro';
import { locales, type Locale } from '../../../i18n';
import { perfumes } from '../../../lib/catalog';

export function getStaticPaths() {
  return locales.flatMap((lang) => perfumes.map((p) => ({ params: { lang, slug: p.slug }, props: { p } })));
}
---

<PerfumeView p={Astro.props.p} locale={Astro.params.lang as Locale} />
