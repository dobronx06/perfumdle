---
import Shell from '../components/Shell.astro';
import type { Locale } from '../i18n';
import { url, families, familyName, genders, seasons, familyCover } from '../lib/catalog';
import { itemListLd } from '../lib/seo';

interface Props { locale: Locale }
const { locale: l } = Astro.props;
const fr = l === 'fr';
---

<Shell
  locale={l}
  title={fr ? 'Familles olfactives : floral, boisé, oriental, chypré…' : 'Olfactory families: floral, woody, oriental, chypre…'}
  description={fr ? `Les ${families.length} familles olfactives expliquées avec leurs parfums emblématiques : floral, oriental, boisé, chypré, fougère, hespéridé, gourmand, cuir…` : `The ${families.length} olfactory families explained with their emblematic perfumes: floral, oriental, woody, chypre, fougère, citrus, gourmand, leather…`}
  alternates={{ fr: url.families('fr'), en: url.families('en') }}
  crumbs={[{ name: fr ? 'Accueil' : 'Home', href: url.home(l) }, { name: fr ? 'Familles' : 'Families' }]}
  eyebrow={fr ? 'Classification' : 'Classification'}
  h1={fr ? 'Les familles olfactives' : 'The olfactory families'}
  lede={fr ? "Les parfumeurs rangent les parfums en grandes familles selon leur accord dominant. Un même parfum peut appartenir à plusieurs d'entre elles : c'est ce qui fait sa nuance." : 'Perfumers sort fragrances into families according to their dominant accord. A single perfume can belong to several — that is where its nuance comes from.'}
  jsonLd={[itemListLd(fr ? 'Familles olfactives' : 'Olfactory families', families.map((f) => ({ name: familyName(f.key, l), href: url.family(l, f.key) })))]}
>
  <div class="tiles">
    {families.map((f) => {
      const img = familyCover[f.key];
      return (
        <a class="tile" href={url.family(l, f.key)} style={`background:${f.tint}`}>
          <span class="tile__name">{familyName(f.key, l)}</span>
          <span class="tile__count">{f.perfumes.length} {fr ? 'parfums' : 'perfumes'}</span>
          {img && <img class="tile__img" src={img} alt="" loading="lazy" width="600" height="600" />}
        </a>
      );
    })}
  </div>
  <section class="section">
    <p class="eyebrow">{fr ? 'Autres sélections' : 'Other edits'}</p>
    <div class="chips" style="margin-top:1rem">
      {genders.map((g) => <a class="chip chip--lg" href={url.gender(l, g.key)}>{fr ? g.name_fr : g.name_en}<small>{g.perfumes.length}</small></a>)}
      {seasons.map((s) => <a class="chip chip--lg" href={url.season(l, s.key)}>{fr ? s.name_fr : s.name_en}<small>{s.perfumes.length}</small></a>)}
    </div>
  </section>
</Shell>
