---
/**
 * Perfumdle, the daily game (v2).
 * One mystery perfume a day, drawn from the 100 best-known perfumes (src/data/game-pool.json).
 * 6 guesses. Each miss unlocks a clue (family + base note at start, then heart note, decade, gender,
 * top note, house initial + blurred bottle). Each guess is compared on 4 clear cells + notes in common.
 * Light editorial theme, same fonts and tokens as the rest of the site. Streak key unchanged (Perfumdle_streak).
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import pool from '../data/game-pool.json';
import type { Locale } from '../i18n';
import { url, perfumes, noteName, familyName, allNotes } from '../lib/catalog';
import { isPublished } from '../lib/schedule';

interface Props { locale: Locale }
const { locale: l } = Astro.props;
const fr = l === 'fr';

/* Main family = the facet named by the first word of the dataset label ("Oriental Woody" -> oriental). */
const FIRST_WORD: Record<string, string> = {
  floral: 'floral', oriental: 'oriental', amber: 'oriental', ambery: 'oriental', woody: 'woody', chypre: 'chypre',
  fougère: 'fougere', fougere: 'fougere', citrus: 'citrus', gourmand: 'gourmand', leather: 'leather', aquatic: 'aquatic',
  marine: 'aquatic', aromatic: 'aromatic', fruity: 'fruity', spicy: 'spicy', musk: 'musky', musky: 'musky',
  green: 'green', powdery: 'powdery', aldehyde: 'powdery',
};
const mainFamily = (p: (typeof perfumes)[number]) => FIRST_WORD[p.family.split(' ')[0].toLowerCase()] ?? p.families[0] ?? 'floral';

const usedNotes = new Set<string>();
const usedFams = new Set<string>();
const entities = perfumes.map((p) => {
  for (const n of allNotes(p)) usedNotes.add(n);
  const fam = mainFamily(p);
  usedFams.add(fam);
  for (const f of p.families) usedFams.add(f);
  return {
    s: p.slug, n: p.name, b: p.brand, y: p.year, g: p.gender, m: fam, f: p.families,
    t: p.notes.top, h: p.notes.heart, d: p.notes.base, i: p.image ?? '',
    sim: isPublished('similar', p.slug) ? 1 : 0,
  };
});
const noteNames = Object.fromEntries([...usedNotes].map((n) => [n, noteName(n, l)]));
const famNames = Object.fromEntries([...usedFams].map((f) => [f, familyName(f, l)]));
const gameData = {
  locale: l, pool, entities, noteNames, famNames,
  perfumeBase: `/${l}/parfum/`, similarBase: `/${l}/${fr ? 'parfums-similaires' : 'similar-perfumes'}/`,
  gameUrl: `https://perfumdle.com${url.game(l)}`,
};

const gameTitle = fr ? 'Perfumdle, le jeu : devinez le parfum du jour' : 'Perfumdle game: guess the perfume of the day';
const gameDesc = fr
  ? 'Un parfum mystère par jour parmi les 100 plus connus. 6 essais, un indice de plus à chaque erreur. Gratuit, sans inscription.'
  : 'One mystery perfume a day among the 100 best known. 6 guesses, one more clue after each miss. Free, no sign-up.';
const gameFaq = fr
  ? [
      { q: 'Perfumdle est-il gratuit ?', a: 'Oui, entièrement gratuit et sans inscription. Votre partie et votre série sont enregistrées dans votre navigateur.' },
      { q: 'À quelle heure change le parfum du jour ?', a: 'À minuit, heure de votre appareil. Tout le monde joue le même parfum le même jour.' },
      { q: 'Faut-il être expert pour gagner ?', a: 'Non. Le parfum du jour fait partie des 100 parfums les plus recherchés, et chaque erreur débloque un indice : note, époque, genre, puis l’initiale de la maison et le flacon flouté.' },
      { q: 'Que veut dire « notes en commun » ?', a: 'C’est le nombre de notes que votre essai partage avec le parfum mystère. Plus il est élevé, plus vous êtes proche. Les notes partagées s’affichent sous votre essai.' },
    ]
  : [
      { q: 'Is Perfumdle free?', a: 'Yes, completely free with no sign-up. Your game and streak are saved in your browser.' },
      { q: 'When does the daily perfume change?', a: 'At midnight, your device’s time. Everyone plays the same perfume on the same day.' },
      { q: 'Do I need to be an expert?', a: 'No. The daily perfume is one of the 100 most searched perfumes, and every miss unlocks a clue: a note, the era, the gender, then the house initial and a blurred bottle.' },
      { q: 'What does “notes in common” mean?', a: 'It is how many notes your guess shares with the mystery perfume. The higher, the closer. Shared notes are listed under your guess.' },
    ];
const gameLd = [
  {
    '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Perfumdle', url: gameData.gameUrl, description: gameDesc,
    genre: ['Puzzle', 'Trivia'], gamePlatform: 'Web browser', applicationCategory: 'Game', inLanguage: l,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: gameFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout locale={l} title={gameTitle} description={gameDesc} alternates={{ fr: url.game('fr'), en: url.game('en') }} jsonLd={gameLd}>
  <div class="page">
    <Header locale={l} altHref={url.game(fr ? 'en' : 'fr')} showStreak />
    <main>
      <div class="wrap game">
        <header class="game__head">
          <p class="eyebrow">{fr ? 'Le jeu quotidien' : 'The daily game'}</p>
          <h1 class="h1 game__title">{fr ? 'Le parfum du jour' : "Today's perfume"}</h1>
          <p class="game__sub">{fr ? 'Trouvez le parfum mystère en 6 essais. Chaque erreur débloque un indice.' : 'Find the mystery perfume in 6 guesses. Every miss unlocks a clue.'}</p>
        </header>

        <div class="game__tabs" role="tablist" aria-label={fr ? 'Mode de jeu' : 'Game mode'}>
          <button type="button" role="tab" data-mode="daily" aria-selected="true">{fr ? 'Parfum du jour' : 'Daily perfume'}</button>
          <button type="button" role="tab" data-mode="train" aria-selected="false">{fr ? 'Entraînement' : 'Practice'}</button>
          <button type="button" class="game__help-btn" id="help-btn" aria-expanded="false" aria-controls="howto" title={fr ? 'Comment jouer' : 'How to play'}>?</button>
        </div>

        <section class="howto-card" id="howto" hidden>
          <ol>
            <li><strong>{fr ? 'Proposez un parfum.' : 'Guess a perfume.'}</strong> {fr ? 'Tapez un nom ou une maison, puis choisissez dans la liste.' : 'Type a name or a house, then pick from the list.'}</li>
            <li><strong>{fr ? 'Lisez les 4 cases.' : 'Read the 4 cells.'}</strong> <span class="mini ok">✓</span> {fr ? 'exact' : 'exact'}, <span class="mini near">≈</span> {fr ? 'proche' : 'close'}, <span class="mini no">✗</span> {fr ? 'différent. La flèche indique si le parfum mystère est plus récent (↑) ou plus ancien (↓).' : 'different. The arrow tells you if the mystery perfume is newer (↑) or older (↓).'}</li>
            <li><strong>{fr ? 'Suivez les notes en commun.' : 'Follow the shared notes.'}</strong> {fr ? 'Et utilisez les indices qui se débloquent à chaque erreur.' : 'And use the clues that unlock after every miss.'}</li>
          </ol>
          <button type="button" class="btn btn--sm" id="howto-close">{fr ? 'Compris' : 'Got it'}</button>
        </section>

        <section class="clues" aria-labelledby="clues-title">
          <h2 class="clues__title" id="clues-title">{fr ? 'Indices' : 'Clues'}</h2>
          <ol class="clues__list" id="clues"></ol>
        </section>

        <div class="guess-box" id="guess-box">
          <label for="guess-input" class="sr-only">{fr ? 'Proposer un parfum' : 'Guess a perfume'}</label>
          <input id="guess-input" type="text" role="combobox" aria-expanded="false" aria-controls="guess-list" aria-autocomplete="list"
            autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={fr ? 'Parfum ou maison…' : 'Perfume or house…'} />
          <ul id="guess-list" role="listbox" hidden></ul>
          <p class="guess-count" id="guess-count" aria-live="polite"></p>
        </div>

        <div class="result" id="result" hidden aria-live="polite"></div>

        <ol class="guesses" id="guesses" aria-live="polite" aria-label={fr ? 'Vos essais' : 'Your guesses'}></ol>
      </div>

      <section class="wrap wrap--text game-seo">
        <h2 class="h2">{fr ? 'Comment jouer à Perfumdle' : 'How to play Perfumdle'}</h2>
        <p>{fr
          ? 'Chaque jour à minuit, un parfum mystère est tiré parmi les 100 parfums les plus recherchés en France, de N°5 à Sauvage en passant par Baccarat Rouge 540. Vous avez 6 essais. Au départ, vous connaissez sa famille olfactive et une note de fond. Chaque erreur ajoute un indice : une note de cœur, la décennie, le genre, une note de tête, puis l’initiale de la maison et le flacon flouté.'
          : 'Every day at midnight, a mystery perfume is drawn from the 100 most searched perfumes, from N°5 to Sauvage and Baccarat Rouge 540. You get 6 guesses. You start with its olfactory family and one base note. Every miss adds a clue: a heart note, the decade, the gender, a top note, then the house initial and a blurred bottle.'}</p>
        <p>{fr
          ? 'Chaque essai est comparé au parfum mystère sur quatre points : la maison, l’époque (avec une flèche vers le plus récent ou le plus ancien), le genre et la famille olfactive. Le compteur de notes en commun vous dit si vous chauffez. Envie de continuer après la partie du jour ? Le mode entraînement tire un nouveau parfum à chaque partie.'
          : 'Each guess is compared on four points: the house, the era (with an arrow towards newer or older), the gender and the olfactory family. The shared-notes counter tells you if you are getting warmer. Want more after today’s game? Practice mode draws a new perfume every time.'}</p>
        <h2 class="h2">{fr ? 'Questions fréquentes' : 'FAQ'}</h2>
        {gameFaq.map((f) => <details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <p class="game-seo__links">
          <a href={url.perfumes(l)}>{fr ? 'Réviser les parfums' : 'Study the perfumes'}</a> ·
          <a href={url.notes(l)}>{fr ? 'Les notes olfactives' : 'Fragrance notes'}</a> ·
          <a href={url.families(l)}>{fr ? 'Les familles olfactives' : 'Olfactory families'}</a>
        </p>
      </section>
    </main>
    <Footer locale={l} />
  </div>

  <script type="application/json" id="game-data" set:html={JSON.stringify(gameData)} />

  <script>
    type G = 'Feminine' | 'Masculine' | 'Unisex';
    interface E { s: string; n: string; b: string; y: number; g: G; m: string; f: string[]; t: string[]; h: string[]; d: string[]; i: string; sim: number }
    interface Data { locale: 'fr' | 'en'; pool: string[]; entities: E[]; noteNames: Record<string, string>; famNames: Record<string, string>; perfumeBase: string; similarBase: string; gameUrl: string }
    type Status = 'ok' | 'near' | 'no';

    const D: Data = JSON.parse(document.getElementById('game-data')!.textContent!);
    const FR = D.locale === 'fr';
    const MAX = 6;
    const BY = new Map(D.entities.map((e) => [e.s, e]));
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const T = (fr: string, en: string) => (FR ? fr : en);
    const GENDER: Record<G, string> = FR ? { Feminine: 'Féminin', Masculine: 'Masculin', Unisex: 'Mixte' } : { Feminine: 'Feminine', Masculine: 'Masculine', Unisex: 'Unisex' };
    const note = (k: string) => D.noteNames[k] ?? k;
    const fam = (k: string) => D.famNames[k] ?? k;
    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    const allNotes = (e: E) => [...new Set([...e.t, ...e.h, ...e.d])];

    /* ---------- storage (never throws) ---------- */
    const store = {
      get<T>(k: string, fb: T): T { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : fb; } catch { return fb; } },
      set(k: string, v: unknown) { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* private mode */ } },
    };

    /* ---------- dates: local calendar day ---------- */
    const pad = (n: number) => String(n).padStart(2, '0');
    const dayStr = (d = new Date()) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const today = dayStr();
    const yesterday = (() => { const d = new Date(); d.setDate(d.getDate() - 1); return dayStr(d); })();

    function mulberry32(a: number) {
      return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    }
    /** Same perfume for everyone on a given day; no repeat until the whole pool has been played. */
    function dailySlug(): string {
      const [y, m, d] = today.split('-').map(Number);
      const idx = Math.floor((Date.UTC(y, m - 1, d) - Date.UTC(2026, 8, 1)) / 86400000);
      const n = D.pool.length;
      const cycle = Math.floor(idx / n);
      const order = D.pool.slice();
      const rnd = mulberry32(cycle * 7919 + 17);
      for (let i = n - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }
      return order[((idx % n) + n) % n];
    }

    /* ---------- state ---------- */
    interface State { target: string; guesses: string[]; done: boolean; won: boolean }
    let mode: 'daily' | 'train' = 'daily';
    const DAILY_KEY = `Perfumdle_v2_daily_${today}`;
    const TRAIN_KEY = 'Perfumdle_v2_train';
    const fresh = (target: string): State => ({ target, guesses: [], done: false, won: false });
    let daily: State = store.get(DAILY_KEY, fresh(dailySlug()));
    if (!BY.has(daily.target)) daily = fresh(dailySlug());
    let train: State = store.get(TRAIN_KEY, fresh(randomTarget()));
    if (!BY.has(train.target)) train = fresh(randomTarget());
    const st = () => (mode === 'daily' ? daily : train);
    const save = () => (mode === 'daily' ? store.set(DAILY_KEY, daily) : store.set(TRAIN_KEY, train));

    function randomTarget(): string {
      const choices = D.pool.filter((s) => s !== dailySlug());
      return choices[Math.floor(Math.random() * choices.length)];
    }

    /* ---------- streak (legacy key kept) ---------- */
    interface Streak { current: number; max: number; lastDate: string }
    const getStreak = (): Streak => store.get('Perfumdle_streak', { current: 0, max: 0, lastDate: '' });
    function recordStreak(won: boolean) {
      const s = getStreak();
      if (s.lastDate === today) return;
      s.current = won ? (s.lastDate === yesterday ? s.current + 1 : 1) : 0;
      s.max = Math.max(s.max, s.current);
      s.lastDate = today;
      store.set('Perfumdle_streak', s);
      renderStreak();
    }
    function renderStreak() { const el = document.getElementById('streak-count'); if (el) el.textContent = String(getStreak().current); }

    /* ---------- comparison ---------- */
    interface Cell { label: string; value: string; status: Status; arrow?: '↑' | '↓' }
    function compare(g: E, t: E): { cells: Cell[]; shared: string[] } {
      const dy = t.y - g.y;
      const gOk = g.g === t.g;
      const gNear = !gOk && (g.g === 'Unisex' || t.g === 'Unisex');
      const famOk = g.m === t.m;
      const famNear = !famOk && g.f.some((x) => t.f.includes(x));
      const tn = new Set(allNotes(t));
      return {
        cells: [
          { label: T('Maison', 'House'), value: g.b, status: g.b === t.b ? 'ok' : 'no' },
          { label: T('Année', 'Year'), value: String(g.y), status: dy === 0 ? 'ok' : Math.abs(dy) <= 5 ? 'near' : 'no', arrow: dy > 0 ? '↑' : dy < 0 ? '↓' : undefined },
          { label: T('Genre', 'Gender'), value: GENDER[g.g], status: gOk ? 'ok' : gNear ? 'near' : 'no' },
          { label: T('Famille', 'Family'), value: fam(g.m), status: famOk ? 'ok' : famNear ? 'near' : 'no' },
        ],
        shared: allNotes(g).filter((n) => tn.has(n)),
      };
    }

    /* ---------- clues ---------- */
    function clues(t: E, done = false): { label: string; value: string; html?: string }[] {
      const decade = Math.floor(t.y / 10) * 10;
      return [
        { label: T('Famille olfactive', 'Olfactory family'), value: fam(t.m) },
        { label: T('Note de fond', 'Base note'), value: note(t.d[0] ?? t.h[0] ?? t.t[0]) },
        { label: T('Note de cœur', 'Heart note'), value: note(t.h[0] ?? t.d[1] ?? t.t[1] ?? '?') },
        { label: T('Époque', 'Era'), value: T(`années ${decade}`, `the ${decade}s`) },
        { label: T('Genre', 'Gender'), value: GENDER[t.g] },
        { label: T('Note de tête', 'Top note'), value: note(t.t[0] ?? t.h[1] ?? '?') },
        done
          ? { label: T('Maison', 'House'), value: t.b }
          : { label: T('Maison', 'House'), value: `${t.b.charAt(0)}…`, html: t.i ? `<img class="blur" src="${t.i}" alt="${T('Flacon flouté', 'Blurred bottle')}" width="80" height="80" />` : '' },
      ];
    }

    /* ---------- rendering ---------- */
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const ICON: Record<Status, string> = { ok: '✓', near: '≈', no: '✗' };
    const SR: Record<Status, string> = FR ? { ok: 'exact', near: 'proche', no: 'différent' } : { ok: 'exact', near: 'close', no: 'different' };

    function render() {
      const s = st();
      const t = BY.get(s.target)!;
      const misses = s.guesses.filter((g) => g !== s.target).length;
      const unlocked = s.done ? 7 : Math.min(7, 2 + misses);
      $('clues').innerHTML = clues(t, s.done).map((c, i) => i < unlocked
        ? `<li class="clue is-open"><span class="clue__label">${c.label}</span><span class="clue__value">${esc(c.value)}</span>${c.html ?? ''}</li>`
        : `<li class="clue"><span class="clue__label">${c.label}</span><span class="clue__lock">${T(`après ${i - 1} erreur${i - 1 > 1 ? 's' : ''}`, `after ${i - 1} miss${i - 1 > 1 ? 'es' : ''}`)}</span></li>`).join('');

      $('guesses').innerHTML = s.guesses.slice().reverse().map((slug) => {
        const g = BY.get(slug)!;
        const { cells, shared } = compare(g, t);
        const win = slug === s.target;
        return `<li class="guess ${win ? 'is-win' : ''}">
          <div class="guess__who">${g.i ? `<img src="${g.i}" alt="" width="48" height="48" loading="lazy" />` : '<span class="guess__ph"></span>'}
            <div><strong>${esc(g.n)}</strong><small>${esc(g.b)} · ${g.y}</small></div></div>
          <div class="guess__cells">${cells.map((c) => `<div class="cell ${c.status}"><span class="cell__label">${c.label}</span>
            <span class="cell__value">${esc(c.value)}${c.arrow ? ` <b aria-label="${c.arrow === '↑' ? T('plus récent', 'newer') : T('plus ancien', 'older')}">${c.arrow}</b>` : ''}</span>
            <span class="cell__icon" aria-hidden="true">${ICON[c.status]}</span><span class="sr-only">${SR[c.status]}</span></div>`).join('')}</div>
          <p class="guess__notes ${shared.length >= 4 ? 'hot' : shared.length >= 2 ? 'warm' : ''}"><strong>${shared.length}</strong> ${T(shared.length > 1 ? 'notes en commun' : 'note en commun', shared.length === 1 ? 'note in common' : 'notes in common')}${shared.length ? `${T(' : ', ': ')}${shared.slice(0, 5).map((n) => esc(note(n))).join(', ')}` : ''}</p>
        </li>`;
      }).join('');

      $('guess-count').textContent = s.done ? '' : T(`Essai ${s.guesses.length + 1} sur ${MAX}`, `Guess ${s.guesses.length + 1} of ${MAX}`);
      $('guess-box').hidden = s.done;
      renderResult();
      document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mode === mode)));
    }

    function shareText(s: State): string {
      const t = BY.get(s.target)!;
      const E: Record<Status, string> = { ok: '🟩', near: '🟨', no: '⬜' };
      const rows = s.guesses.map((slug) => { const c = compare(BY.get(slug)!, t); return c.cells.map((x) => E[x.status]).join('') + ` ${c.shared.length}🌸`; });
      const date = new Date().toLocaleDateString(FR ? 'fr-FR' : 'en-GB', { day: '2-digit', month: '2-digit' });
      return `Perfumdle ${mode === 'daily' ? date : T('entraînement', 'practice')} · ${s.won ? s.guesses.length : 'X'}/${MAX}\n${rows.join('\n')}\n${D.gameUrl}`;
    }

    function renderResult() {
      const s = st();
      const box = $('result');
      if (!s.done) { box.hidden = true; return; }
      const t = BY.get(s.target)!;
      const streak = getStreak();
      box.hidden = false;
      box.innerHTML = `
        <div class="result__media">${t.i ? `<img src="${t.i}" alt="${esc(t.n)} ${esc(t.b)}" width="220" height="220" />` : ''}</div>
        <div class="result__body">
          <p class="eyebrow">${s.won ? T(`Trouvé en ${s.guesses.length} essai${s.guesses.length > 1 ? 's' : ''}`, `Found in ${s.guesses.length} guess${s.guesses.length > 1 ? 'es' : ''}`) : T('Perdu cette fois', 'Not this time')}</p>
          <h2 class="h2">${esc(t.n)} <small>${esc(t.b)} · ${t.y}</small></h2>
          ${mode === 'daily' ? `<p class="result__stats">${T('Série', 'Streak')} : <strong>${streak.current}</strong> · ${T('record', 'best')} : ${streak.max} · <span id="countdown"></span></p>` : ''}
          <div class="result__actions">
            <button type="button" class="btn btn--gold" id="share-btn">${T('Partager mon résultat', 'Share my result')}</button>
            <a class="btn" href="${D.perfumeBase}${t.s}/">${T('Voir la fiche', 'Read the profile')}</a>
            ${t.sim ? `<a class="btn" href="${D.similarBase}${t.s}/">${T('Parfums similaires', 'Similar perfumes')}</a>` : ''}
            <button type="button" class="btn" id="train-btn">${mode === 'daily' ? T('Jouer en entraînement', 'Play practice') : T('Nouvelle partie', 'New game')}</button>
          </div>
          <p class="result__copied" id="copied" hidden>${T('Résultat copié', 'Result copied')}</p>
        </div>`;
      $('share-btn').onclick = async () => {
        const text = shareText(s);
        try { if (navigator.share) { await navigator.share({ text }); return; } } catch { /* cancelled */ }
        try { await navigator.clipboard.writeText(text); $('copied').hidden = false; } catch { /* no clipboard */ }
      };
      $('train-btn').onclick = () => { if (mode === 'train') train = fresh(randomTarget()); setMode('train'); save(); };
      tick();
    }

    function tick() {
      const el = document.getElementById('countdown');
      if (!el) return;
      const now = new Date();
      const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
      const ms = next.getTime() - now.getTime();
      el.textContent = T('Prochain parfum dans ', 'Next perfume in ') + `${Math.floor(ms / 3600000)} h ${pad(Math.floor(ms / 60000) % 60)}`;
    }
    setInterval(tick, 30000);

    /* ---------- guessing ---------- */
    function guess(slug: string) {
      const s = st();
      if (s.done || s.guesses.includes(slug)) return;
      s.guesses.push(slug);
      if (slug === s.target) { s.done = true; s.won = true; }
      else if (s.guesses.length >= MAX) { s.done = true; }
      if (s.done && mode === 'daily') recordStreak(s.won);
      save();
      render();
      if (s.done) $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ---------- search / combobox ---------- */
    const input = $<HTMLInputElement>('guess-input');
    const list = $('guess-list');
    const index = D.entities.map((e) => ({ e, key: norm(`${e.n} ${e.b}`) }));
    let options: E[] = [];
    let active = -1;
    /** Name starting with the query first, then a name word starting with it, then house matches. */
    function rank(e: E, words: string[]): number {
      const n = norm(e.n);
      if (n.startsWith(words.join(' '))) return 0;
      if (n.startsWith(words[0])) return 1;
      if (n.split(' ').some((w) => w.startsWith(words[0]))) return 2;
      return 3;
    }
    function search(q: string) {
      const nq = norm(q);
      const s = st();
      if (!nq) { options = []; } else {
        const words = nq.split(' ');
        options = index.filter((x) => !s.guesses.includes(x.e.s) && words.every((w) => x.key.includes(w)))
          .sort((a, b) => rank(a.e, words) - rank(b.e, words) || a.e.n.length - b.e.n.length || a.e.n.localeCompare(b.e.n))
          .slice(0, 8).map((x) => x.e);
      }
      active = options.length ? 0 : -1;
      drawList();
    }
    function drawList() {
      list.hidden = !options.length && !input.value;
      input.setAttribute('aria-expanded', String(!list.hidden));
      list.innerHTML = options.length
        ? options.map((e, i) => `<li role="option" id="opt-${i}" data-slug="${e.s}" aria-selected="${i === active}">
            ${e.i ? `<img src="${e.i}" alt="" width="36" height="36" loading="lazy" />` : '<span class="opt-ph"></span>'}
            <span><strong>${esc(e.n)}</strong><small>${esc(e.b)} · ${e.y}</small></span></li>`).join('')
        : input.value ? `<li class="empty">${T('Aucun parfum trouvé', 'No perfume found')}</li>` : '';
      if (active >= 0) input.setAttribute('aria-activedescendant', `opt-${active}`); else input.removeAttribute('aria-activedescendant');
    }
    function pick(i: number) {
      const e = options[i];
      if (!e) return;
      input.value = ''; options = []; drawList(); list.hidden = true;
      guess(e.s);
      input.focus();
    }
    input.addEventListener('input', () => search(input.value));
    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowDown') { active = Math.min(options.length - 1, active + 1); drawList(); ev.preventDefault(); }
      else if (ev.key === 'ArrowUp') { active = Math.max(0, active - 1); drawList(); ev.preventDefault(); }
      else if (ev.key === 'Enter') { pick(active); ev.preventDefault(); }
      else if (ev.key === 'Escape') { options = []; list.hidden = true; }
    });
    list.addEventListener('mousedown', (ev) => {
      const li = (ev.target as HTMLElement).closest<HTMLElement>('[data-slug]');
      if (li) { ev.preventDefault(); pick(options.findIndex((o) => o.s === li.dataset.slug)); }
    });
    input.addEventListener('blur', () => setTimeout(() => { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }, 120));

    /* ---------- modes & help ---------- */
    function setMode(m: 'daily' | 'train') { mode = m; input.value = ''; options = []; drawList(); list.hidden = true; render(); }
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as 'daily' | 'train')));
    const help = $('howto');
    const helpBtn = $('help-btn');
    const toggleHelp = (open: boolean) => { help.hidden = !open; helpBtn.setAttribute('aria-expanded', String(open)); store.set('Perfumdle_v2_seen_help', true); };
    helpBtn.addEventListener('click', () => toggleHelp(help.hidden));
    $('howto-close').addEventListener('click', () => toggleHelp(false));
    if (!store.get('Perfumdle_v2_seen_help', false)) help.hidden = false;

    renderStreak();
    render();
  </script>
</Layout>

